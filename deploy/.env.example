# 股票日记自托管后端配置（复制为 .env 后修改）

# 服务端口
PORT=3000

# K 线定时采集：每天该时刻（服务器本地时间，建议收盘后如 17:30）自动增量入库。
# 留空/缺省 = 17:30。另：后端启动时会自动补齐一次（库空则全市场回补，3-5 分钟）。
SYNC_AT=17:30

# PostgreSQL 连接串（install 脚本会自动生成；手动安装时改成你的密码）
DATABASE_URL=postgresql://stockjournal:CHANGE_ME@localhost:5432/stockjournal

# 访问密钥校验（可选）：1 = 必须带 x-wb-webapp-access-key 头且等于 ACCESS_KEY；
# 0/缺省 = 不校验（前端固定带一个 key 头，仅作为与云端协议兼容的占位）。
# 公网部署建议 REQUIRE_KEY=1 并自定义 ACCESS_KEY，再加反向代理 HTTPS。
REQUIRE_KEY=0
ACCESS_KEY=
